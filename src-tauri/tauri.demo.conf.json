{
  "productName": "StudioManager Demo",
  "identifier": "ch.studiomanager.demo",
  "app": {
    "windows": [
      {
        "title": "StudioManager Demo",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/lorisbriguet/StudioManager/releases/latest/download/demo-latest.json"
      ]
    }
  },
  "bundle": {
    "createUpdaterArtifacts": false,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons-demo/32x32.png",
      "icons-demo/128x128.png",
      "icons-demo/128x128@2x.png",
      "icons-demo/icon.icns",
      "icons-demo/icon.ico"
    ],
    "macOS": {
      "files": {
        "Resources/Assets.car": "icons-demo/Assets.car"
      }
    }
  }
}
