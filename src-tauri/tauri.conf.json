{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "StudioManager",
  "version": "3.4.0",
  "identifier": "ch.studiomanager.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bash scripts/build-mcp.sh && npm run dev",
    "beforeBuildCommand": "bash scripts/build-mcp.sh && npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "StudioManager",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: blob: data:; font-src 'self' data:; frame-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https://api.frankfurter.app"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/lorisbriguet/StudioManager/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwNzM5ODk2NkJENDRGMzEKUldReFQ5UnJscGh6Y0tDR01yYXdZcWpQYUhxZklDN2VJOEtEODRGMDVaMVZqN3k1VnY5cDBmQ0YK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/studiomanager-mcp"
    ],
    "macOS": {
      "signingIdentity": "-",
      "files": {
        "Resources/Assets.car": "icons/Assets.car"
      }
    }
  }
}
